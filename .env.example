# Unity LevelPlay settings for the ANDROID DIRECT build only (npm run build:android-direct). The store build (android-play) uses AdMob and ignores these.
# Copy this file to `.env.android-direct.local` (git-ignored, never commit it) and fill in the values from the LevelPlay dashboard.
# Missing or placeholder values = the app runs normally with no ads.
VITE_LEVELPLAY_APP_KEY=YOUR_APP_KEY
VITE_LEVELPLAY_REWARDED_ID=YOUR_REWARDED_AD_UNIT_ID
VITE_LEVELPLAY_INTERSTITIAL_ID=YOUR_INTERSTITIAL_AD_UNIT_ID
VITE_LEVELPLAY_BANNER_ID=YOUR_BANNER_AD_UNIT_ID
# true = LevelPlay test mode (test suite). Use it for development builds only, never for a store build.
VITE_LEVELPLAY_TEST=true
