{
  "name": "chef-rush",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:crazygames": "tsc --noEmit && vite build --mode crazygames",
    "build:android": "tsc --noEmit && vite build --mode android",
    "android:sync": "npm run build:android && cap sync android",
    "android:open": "cap open android",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.3.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
